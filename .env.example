# Copy to `.env` on the VPS (never commit `.env`).
# This file configures the Docker coordinator, not the laptops.

# TCP port published on the VPS. Laptops use VPS_PUBLIC_IP:this_port.
MYNET_COORD_PORT=9993

# Shared membership secret. Put the same value on laptops:
#   mynet join --coordinator VPS_PUBLIC_IP:9993 --token <this value> --ip 10.42.0.N
MYNET_JOIN_TOKEN=change-me-to-a-long-random-string

# Optional label stored on the server (informational).
MYNET_NETWORK=office

# Optional two-peer UDP relay (docker compose --profile relay up -d).
# Laptops: sudo mynet connect --relay VPS_PUBLIC_IP:9994
MYNET_RELAY_PORT=9994
