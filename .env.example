# Copy to `.env` on the VPS (never commit `.env`).
# This file configures the Docker coordinator + relay, not the laptops.

# TCP port published on the VPS. Discovery / join.
MYNET_COORD_PORT=9993

# Optional lab membership secret for `mynet join --token`.
# `rnet start` creates its own session token (32 hex chars) even if this is set.
MYNET_JOIN_TOKEN=change-me-to-a-long-random-string

# Optional label stored on the server (informational).
MYNET_NETWORK=office

# UDP pair relay for two peers behind NAT (required for internet start/connect).
MYNET_RELAY_PORT=9994
